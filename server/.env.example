PORT=5000
# Local MongoDB or Atlas connection string.
# If unreachable, the server falls back to an in-memory MongoDB (demo only, data resets on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/flowlens
USE_MEMORY_FALLBACK=true
SEED_DEMO=true
AUTH_SECRET=change-this-to-a-long-random-string

# Google Sign-In: OAuth Client ID from Google Cloud Console (leave empty to hide the Google button)
GOOGLE_CLIENT_ID=

# ---- Security (all optional; sensible defaults are built in) ----
# Generate AUTH_SECRET with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production (NODE_ENV=production) the server refuses to start if AUTH_SECRET is short or a placeholder.
NODE_ENV=development
TOKEN_TTL_HOURS=12
# Browser origins allowed to call the API from another origin (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set when running behind a reverse proxy / load balancer so client IPs (rate limiting, logs) are correct. 1 = one proxy hop.
TRUST_PROXY=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_IP_MAX=1000
RATE_LIMIT_USER_MAX=600
